# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://mingalbank:mingalbank@localhost:5432/mingalbank?schema=public"

# Secret used to sign JWTs (parents and children). Use a long random string in production.
JWT_SECRET="change-me-super-secret"

# Port the HTTP server listens on
PORT=3333

# Access token lifetime (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN="7d"
